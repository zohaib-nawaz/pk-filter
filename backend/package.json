{
  "name": "netvron-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate": "tsx --env-file-if-exists=.env src/database/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "geoip:update": "node scripts/update-geoip.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.12.7",
    "maxmind": "^5.0.8",
    "pg": "^8.23.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
