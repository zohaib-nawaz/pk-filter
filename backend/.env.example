PORT=8787
HOST=0.0.0.0
TRUST_PROXY=true
LOG_LEVEL=info

# Two-letter code of the country this server runs in, and the network it is on
PROBE_COUNTRY=
PROBE_ISP=
PROBE_ASN=
PROBE_CITY=

DNS_SERVERS=
CONTROL_DOH_URL=https://cloudflare-dns.com/dns-query

OONI_ENABLED=true
OONI_BASE_URL=https://api.ooni.io

CHECK_CONCURRENCY=6
RATE_LIMIT_PER_MINUTE=60
RETENTION_DAYS=30

DATABASE_URL=

# Other ISPs in the same country, or COUNTRY=url for test servers in other countries
PEER_PROBES=
PROBE_TOKEN=

# Country database from `npm run geoip:update` (DB-IP IP to Country Lite, CC BY 4.0)
GEOIP_DB=data/dbip-country-lite.mmdb

# Websites allowed to call the API from a browser (the project website)
CORS_ORIGINS=http://localhost:3180

# Video download route on the website (/api/v1/media/*)
MEDIA_DOWNLOADS=true
# At least 32 characters; keeps download links valid across restarts
MEDIA_SECRET=
MEDIA_MAX_MB=4096
MEDIA_MAX_CONCURRENT=6
MEDIA_MAX_PER_CLIENT=2
